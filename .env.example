# Copy to .env in a private folder (never commit it) and fill in the keys you use.
# The tools read the variable named by --api-key-env; these are the defaults.

# Claude through the Anthropic API (grading, reading exam headers): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Any other model through OpenRouter (question generation default, other providers): https://openrouter.ai/keys
OPENROUTER_API_KEY=
